{
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc && npm run build:server && vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=server-dist/index.mjs",
    "start": "node server-dist/index.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:supabase:live": "tsx --test tests/supabase-rls-live.ts",
    "validate": "npm run build && npm test",
    "supabase:start": "supabase start",
    "supabase:db:reset": "supabase db reset"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/static": "^9.1.3",
    "@supabase/supabase-js": "^2.105.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "lucide-react": "latest",
    "marked": "^18.0.3",
    "pdfjs-dist": "^5.7.284",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "latest",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.0",
    "supabase": "^2.98.2",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "latest"
  }
}
